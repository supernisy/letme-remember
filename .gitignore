# 索引缓存（可重建，不入库）
.index/
*.db
*.sqlite
*.sqlite3

# 记忆数据：真实记忆只存代码仓库外的私有数据目录。
# 下面这些是防御性兜底，防止误把数据目录放进本仓库时被提交。
# 用 / 前缀锚定到仓库根，避免误伤 openspec/changes/archive/ 等合法子目录。
/store/
/MEMORY.md
/audit.log
/config.json
/proposals/
/staging/

# 本地环境
.venv/
__pycache__/
*.pyc

# 系统文件
.DS_Store
Thumbs.db
.openspec-archive.lock

# 本地临时调试产物（截图 / 探针 / 凭据文件，禁止入库）
/_*.png
/_*.py
/_*.json
/_*.txt

# 测试覆盖率缓存
.coverage
htmlcov/
.pytest_cache/

# 前端工程（gui/）：依赖与构建产物可重建，不入库
# 与「索引可重建不入库」哲学一致——首次使用 GUI 需 cd gui && pnpm install && pnpm build
gui/node_modules/
gui/dist/
*.tsbuildinfo

# verify-suite 采集临时产物（语义指纹 JSON 等，可重采，不入库）
/out/
